{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "ListRawBucket",
            "Effect": "Allow",
            "Action": [
                "s3:ListBucket",
                "s3:GetBucketLocation"
            ],
            "Resource": "arn:aws:s3:::${S3_BUCKET_RAW}"
        },
        {
            "Sid": "ReadRawObjects",
            "Effect": "Allow",
            "Action": "s3:GetObject",
            "Resource": "arn:aws:s3:::${S3_BUCKET_RAW}/*"
        }
    ]
}
