{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "ListStagingBucket",
            "Effect": "Allow",
            "Action": [
                "s3:ListBucket",
                "s3:GetBucketLocation"
            ],
            "Resource": "arn:aws:s3:::${S3_BUCKET_STAGING}"
        },
        {
            "Sid": "ReadWriteStagingObjects",
            "Effect": "Allow",
            "Action": [
                "s3:GetObject",
                "s3:PutObject",
                "s3:DeleteObject",
                "s3:GetObjectTagging",
                "s3:PutObjectTagging"
            ],
            "Resource": "arn:aws:s3:::${S3_BUCKET_STAGING}/*"
        }
    ]
}
