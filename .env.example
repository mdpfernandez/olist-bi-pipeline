# olist-bi-pipeline — environment variables
#
# Copy this file to .env and fill in the values. .env is gitignored.
# Never commit a populated .env to the repo.
#
# See docs/setup/03-local-environment.md for guidance on how to obtain each value.

# ─────────────────────────────────────────────────────────────────────────────
# AWS
# ─────────────────────────────────────────────────────────────────────────────
# The AWS CLI profile configured in docs/setup/02-aws-account.md
AWS_PROFILE=olist-portfolio
# Region — pick once, stick with it. eu-west-1 = Ireland (recommended for Madrid).
AWS_REGION=eu-west-1
# Your 12-digit AWS account ID. Get it with: aws sts get-caller-identity --query Account --output text
AWS_ACCOUNT_ID=123456789012

# ─────────────────────────────────────────────────────────────────────────────
# S3 buckets — names must be GLOBALLY UNIQUE across all of AWS.
# Suggested pattern: olist-<purpose>-<initials>-<suffix>
# If a name is taken, change the suffix.
# ─────────────────────────────────────────────────────────────────────────────
S3_BUCKET_RAW=olist-raw-mfern-xx
S3_BUCKET_STAGING=olist-staging-mfern-xx
S3_BUCKET_CURATED=olist-curated-mfern-xx
S3_BUCKET_ATHENA_RESULTS=olist-athena-results-mfern-xx

# ─────────────────────────────────────────────────────────────────────────────
# AWS Glue
# ─────────────────────────────────────────────────────────────────────────────
GLUE_DATABASE=olist_dev
GLUE_ROLE_NAME=olist-glue-role
# Glue Job names — used by the orchestration Lambdas
GLUE_JOB_STAGING_PREFIX=olist-staging
GLUE_JOB_CURATED=olist-build-curated

# ─────────────────────────────────────────────────────────────────────────────
# Athena
# ─────────────────────────────────────────────────────────────────────────────
ATHENA_WORKGROUP=olist-dev

# ─────────────────────────────────────────────────────────────────────────────
# Kaggle — for downloading the Olist dataset.
# Get these from kaggle.com → Settings → API → "Create New Token"
# (downloads kaggle.json which contains both values)
# ─────────────────────────────────────────────────────────────────────────────
KAGGLE_USERNAME=your_kaggle_username
KAGGLE_KEY=your_kaggle_api_key

# ─────────────────────────────────────────────────────────────────────────────
# Frankfurter API (FX rates enrichment) — no API key required, free for non-commercial use.
# Provided here as an env var so we can swap to a paid provider later if needed.
# ─────────────────────────────────────────────────────────────────────────────
FX_API_BASE_URL=https://api.frankfurter.app

# ─────────────────────────────────────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# json | console — use json in Lambda, console for local development
LOG_FORMAT=console

# ─────────────────────────────────────────────────────────────────────────────
# Pipeline runtime config
# ─────────────────────────────────────────────────────────────────────────────
# dev | prod — only "dev" exists for portfolio
ENVIRONMENT=dev
# Mandatory tag value, applied by core/aws.py to every resource we create
PROJECT_TAG=olist-pipeline
OWNER_TAG=marianela
